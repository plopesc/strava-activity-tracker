<turbo-frame id="activity-detail">
    <div class="bg-gray-900 rounded-xl border border-gray-800 p-4 space-y-4">
        <div class="flex items-start justify-between">
            <div>
                <h3 class="font-semibold text-gray-100 text-base leading-tight">{{ activity.name }}</h3>
                <p class="text-sm text-gray-400 mt-0.5">{{ activity.activityDate|date('D, M j, Y') }}</p>
            </div>
            {% set typeLabels = {'steady': 'Steady', 'interval': 'Intervals', 'short_run': 'Short Run', 'long_run': 'Long Run'} %}
            <span class="text-xs px-2 py-1 rounded-full
                {% if activity.patternType == 'short_run' %}bg-blue-900 text-blue-300
                {% elseif activity.patternType == 'interval' %}bg-orange-900 text-orange-300
                {% elseif activity.patternType == 'steady' %}bg-red-900 text-red-300
                {% elseif activity.patternType == 'long_run' %}bg-green-900 text-green-300
                {% else %}bg-gray-800 text-gray-400{% endif %}">
                {{ typeLabels[activity.patternType] ?? 'Unclassified' }}
            </span>
        </div>

        <dl class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
            <dt class="text-gray-500">Distance</dt>
            <dd class="text-gray-200 font-medium">{{ activity.distance is not null ? (activity.distance / 1000)|number_format(2) ~ ' km' : '—' }}</dd>

            <dt class="text-gray-500">Pace</dt>
            <dd class="text-gray-200 font-medium">{{ activity.averageSpeed is not null ? activity.averageSpeed|pace_format : '—' }}</dd>

            <dt class="text-gray-500">Duration</dt>
            <dd class="text-gray-200 font-medium">{{ activity.elapsedTime is not null ? activity.elapsedTime|duration_format : '—' }}</dd>

            <dt class="text-gray-500">Avg HR</dt>
            <dd class="text-gray-200 font-medium">{{ activity.averageHeartrate is not null ? activity.averageHeartrate ~ ' bpm' : '—' }}</dd>

            <dt class="text-gray-500">Max HR</dt>
            <dd class="text-gray-200 font-medium">{{ activity.maxHeartrate is not null ? activity.maxHeartrate ~ ' bpm' : '—' }}</dd>

            <dt class="text-gray-500">Gear</dt>
            <dd class="text-gray-200 font-medium">{{ activity.gear is not null ? activity.gear.name : '—' }}</dd>
        </dl>

        {% if activity.patternSignature %}
            <div class="pt-2 border-t border-gray-800">
                <p class="text-xs text-gray-500 mb-1">Pattern</p>
                <a href="{{ path('activity_pattern_detail', {signature: activity.patternSignature}) }}"
                   data-turbo-frame="_top"
                   class="text-sm font-medium text-strava-orange hover:underline flex items-center gap-1">
                    {{ activity.patternSignature }}
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
            </div>
        {% endif %}

        <div class="pt-2 border-t border-gray-800 flex items-center justify-between">
            <a href="{{ path('activity_detail', {id: activity.id}) }}"
               data-turbo-frame="_top"
               class="inline-flex items-center gap-1.5 text-sm font-medium text-strava-orange hover:underline">
                View Activity
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </a>
            <a href="https://www.strava.com/activities/{{ activity.stravaId }}"
               target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-1.5 text-xs text-gray-500 hover:text-gray-300">
                Strava
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
            </a>
        </div>
    </div>
</turbo-frame>
