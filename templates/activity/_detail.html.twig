<turbo-frame id="activity-detail">
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-4 space-y-4">
        <div class="flex items-start justify-between">
            <div>
                <h3 class="font-semibold text-gray-900 text-base leading-tight">{{ activity.name }}</h3>
                <p class="text-sm text-gray-500 mt-0.5">{{ activity.activityDate|date('D, M j, Y') }}</p>
            </div>
            {% set typeLabels = {'steady': 'Steady', 'intervals': 'Intervals', 'tempo': 'Tempo', 'long_run': 'Long Run'} %}
            <span class="text-xs px-2 py-1 rounded-full
                {% if activity.patternType == 'steady' %}bg-blue-100 text-blue-700
                {% elseif activity.patternType == 'intervals' %}bg-orange-100 text-orange-700
                {% elseif activity.patternType == 'tempo' %}bg-red-100 text-red-700
                {% elseif activity.patternType == 'long_run' %}bg-green-100 text-green-700
                {% else %}bg-gray-100 text-gray-600{% endif %}">
                {{ typeLabels[activity.patternType] ?? 'Unclassified' }}
            </span>
        </div>

        <dl class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
            <dt class="text-gray-500">Distance</dt>
            <dd class="text-gray-900 font-medium">{{ activity.distance is not null ? (activity.distance / 1000)|number_format(2) ~ ' km' : '—' }}</dd>

            <dt class="text-gray-500">Pace</dt>
            <dd class="text-gray-900 font-medium">{{ activity.averageSpeed is not null ? activity.averageSpeed|pace_format : '—' }}</dd>

            <dt class="text-gray-500">Duration</dt>
            <dd class="text-gray-900 font-medium">{{ activity.elapsedTime is not null ? activity.elapsedTime|duration_format : '—' }}</dd>

            <dt class="text-gray-500">Avg HR</dt>
            <dd class="text-gray-900 font-medium">{{ activity.averageHeartrate is not null ? activity.averageHeartrate ~ ' bpm' : '—' }}</dd>

            <dt class="text-gray-500">Max HR</dt>
            <dd class="text-gray-900 font-medium">{{ activity.maxHeartrate is not null ? activity.maxHeartrate ~ ' bpm' : '—' }}</dd>

            <dt class="text-gray-500">Gear</dt>
            <dd class="text-gray-900 font-medium">{{ activity.gear is not null ? activity.gear.name : '—' }}</dd>
        </dl>

        {% if activity.patternSignature %}
            <div class="pt-2 border-t border-gray-100">
                <p class="text-xs text-gray-500 mb-1">Pattern</p>
                <a href="{{ path('activity_pattern_detail', {signature: activity.patternSignature}) }}"
                   data-turbo-frame="_top"
                   class="text-sm font-medium text-strava-orange hover:underline flex items-center gap-1">
                    {{ activity.patternSignature }}
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
            </div>
        {% endif %}
    </div>
</turbo-frame>
