{% extends 'base.html.twig' %}

{% block title %}{{ signature }} — Strava Analyser{% endblock %}

{% block content %}
<h1>Pattern: {{ signature }}</h1>
<p><a href="{{ path('activity_pattern_list') }}">← All patterns</a></p>

{% if trendText %}
    <p><strong>Trend:</strong> {{ trendText }}</p>
{% endif %}

{% if activities is empty %}
    <p>No activities found for this pattern.</p>
{% else %}
<form method="GET" action="{{ path('activity_compare') }}" id="compare-form">
    <table>
        <thead>
            <tr>
                <th><input type="checkbox" id="select-all"></th>
                <th>Date</th>
                <th>Name</th>
                <th>Distance</th>
                <th>Avg Pace</th>
                <th>Duration</th>
                <th>Avg HR</th>
            </tr>
        </thead>
        <tbody>
        {% for activity in activities %}
            <tr>
                <td><input type="checkbox" name="ids[]" value="{{ activity.id }}"></td>
                <td>{{ activity.activityDate|date('Y-m-d') }}</td>
                <td>{{ activity.name }}</td>
                <td>{{ (activity.distance / 1000)|number_format(1) }} km</td>
                <td>{{ activity.averageSpeed|pace_format }}</td>
                <td>{{ activity.elapsedTime|duration_format }}</td>
                <td>{{ activity.averageHeartrate ? activity.averageHeartrate|round ~ ' bpm' : '—' }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    <button type="submit">Compare selected</button>
</form>

<script>
document.getElementById('compare-form').addEventListener('submit', function(e) {
    var checked = this.querySelectorAll('input[name="ids[]"]:checked');
    if (checked.length < 2) {
        e.preventDefault();
        alert('Please select at least 2 activities to compare.');
    }
});
document.getElementById('select-all').addEventListener('change', function() {
    document.querySelectorAll('input[name="ids[]"]').forEach(cb => cb.checked = this.checked);
});
</script>
{% endif %}
{% endblock %}
