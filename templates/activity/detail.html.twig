{% extends 'base.html.twig' %}

{% block title %}{{ activity.name }} — Strava Analyser{% endblock %}

{% block content %}
<div class="max-w-lg">
    <a href="{{ app.request.headers.get('referer') is not empty ? 'javascript:history.back()' : path('activity_calendar') }}"
       class="text-sm text-gray-400 hover:text-gray-200 inline-flex items-center gap-1 mb-4">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Back
    </a>

    {% include 'activity/card.html.twig' %}
</div>
{% endblock %}
